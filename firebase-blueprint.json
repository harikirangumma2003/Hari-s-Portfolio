{
  "entities": {
    "ContactSubmission": {
      "title": "Contact Submission",
      "description": "Details from a contact form submission.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The full name of the contact."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The email address of the contact."
        },
        "subject": {
          "type": "string",
          "description": "The subject of the inquiry."
        },
        "message": {
          "type": "string",
          "description": "The inquiry message."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The time the submission was created."
        }
      },
      "required": ["name", "email", "subject", "message", "createdAt"]
    },
    "PartnerSubmission": {
      "title": "Partner Submission",
      "description": "Details from a partner page sign-up/application.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The full name of the applying partner."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The corporate email address."
        },
        "website": {
          "type": "string",
          "description": "The company website URL."
        },
        "tier": {
          "type": "string",
          "description": "The preferred partnership tier package."
        },
        "budget": {
          "type": "string",
          "description": "Monthly budget tier for the collaboration."
        },
        "message": {
          "type": "string",
          "description": "The business outline message."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The time the application was received."
        }
      },
      "required": ["name", "email", "website", "tier", "budget", "message", "createdAt"]
    },
    "ContentHubItem": {
      "title": "Content Hub Item",
      "description": "A syndicated content asset published across various platforms.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "excerpt": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "thumbnail": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "contentType": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "url": {
          "type": "string"
        },
        "featured": {
          "type": "boolean"
        },
        "publishedDate": {
          "type": "string"
        },
        "readTime": {
          "type": "string"
        },
        "views": {
          "type": "integer"
        },
        "likes": {
          "type": "integer"
        },
        "author": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "role": { "type": "string" },
            "image": { "type": "string" }
          }
        },
        "status": {
          "type": "string"
        },
        "visibility": {
          "type": "string"
        }
      },
      "required": ["title", "excerpt", "description", "thumbnail", "platform", "contentType", "category", "tags", "url", "featured", "publishedDate", "readTime", "status", "visibility"]
    },
    "AutomationSettings": {
      "title": "Automation Settings",
      "description": "Global automation control settings for synching content from external platforms.",
      "type": "object",
      "properties": {
        "mediumEnabled": { "type": "boolean" },
        "youtubeEnabled": { "type": "boolean" },
        "linkedinEnabled": { "type": "boolean" },
        "instagramEnabled": { "type": "boolean" },
        "threadsEnabled": { "type": "boolean" },
        "xEnabled": { "type": "boolean" },
        "autoSync": { "type": "boolean" },
        "syncInterval": { "type": "integer" },
        "lastGlobalSync": { "type": "string", "format": "date-time" }
      },
      "required": ["mediumEnabled", "youtubeEnabled", "linkedinEnabled", "instagramEnabled", "threadsEnabled", "xEnabled", "autoSync", "syncInterval"]
    },
    "SyncLog": {
      "title": "Sync Log",
      "description": "Log details of a specific platform synchronization run.",
      "type": "object",
      "properties": {
        "platform": { "type": "string" },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string" },
        "imported": { "type": "integer" },
        "updated": { "type": "integer" },
        "skipped": { "type": "integer" },
        "failed": { "type": "integer" },
        "duration": { "type": "integer" },
        "errors": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["platform", "startedAt", "completedAt", "status", "imported", "updated", "skipped", "failed", "duration", "errors"]
    },
    "UpiTransaction": {
      "title": "UPI Transaction",
      "description": "Details from a UPI transaction submission for digital downloads.",
      "type": "object",
      "properties": {
        "utr": {
          "type": "string",
          "description": "The 12-digit UPI transaction reference / UTR number."
        },
        "name": {
          "type": "string",
          "description": "The name of the purchaser."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The email address of the purchaser."
        },
        "amount": {
          "type": "integer",
          "description": "The paid amount in INR."
        },
        "resourceId": {
          "type": "string",
          "description": "The ID of the digital resource purchased."
        },
        "resourceTitle": {
          "type": "string",
          "description": "The title of the digital resource."
        },
        "status": {
          "type": "string",
          "description": "The transaction verification status (e.g., pending, verified, failed)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp of when the transaction was submitted."
        }
      },
      "required": ["utr", "name", "email", "amount", "resourceId", "resourceTitle", "status", "createdAt"]
    },
    "BlogReaction": {
      "title": "Blog Reaction",
      "description": "Aggregated real-time likes, claps, and reactions for a blog post.",
      "type": "object",
      "properties": {
        "postSlug": { "type": "string" },
        "claps": { "type": "integer" },
        "insights": { "type": "integer" },
        "hearts": { "type": "integer" },
        "rockets": { "type": "integer" },
        "totalReactions": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["postSlug", "claps", "insights", "hearts", "rockets", "totalReactions"]
    },
    "BlogComment": {
      "title": "Blog Comment",
      "description": "Reader discussion comments, questions, and author replies on blog posts.",
      "type": "object",
      "properties": {
        "postSlug": { "type": "string" },
        "authorName": { "type": "string" },
        "authorRole": { "type": "string" },
        "authorEmail": { "type": "string", "format": "email" },
        "content": { "type": "string" },
        "parentId": { "type": "string" },
        "isAuthor": { "type": "boolean" },
        "isPinned": { "type": "boolean" },
        "likes": { "type": "integer" },
        "status": { "type": "string", "enum": ["published", "pending", "hidden"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["postSlug", "authorName", "content", "status", "createdAt"]
    }
  },
  "firestore": {
    "contacts/{submissionId}": {
      "schema": "ContactSubmission",
      "description": "Submissions from the contact form."
    },
    "partners_submissions/{submissionId}": {
      "schema": "PartnerSubmission",
      "description": "Applications submitted through the Become a Partner form."
    },
    "upi_transactions/{transactionId}": {
      "schema": "UpiTransaction",
      "description": "Verified UPI payment records for digital downloads."
    },
    "content/{contentId}": {
      "schema": "ContentHubItem",
      "description": "Curated omnichannel growth assets and published articles."
    },
    "automation/{settingsId}": {
      "schema": "AutomationSettings",
      "description": "Global configuration settings for Content Automation."
    },
    "syncLogs/{logId}": {
      "schema": "SyncLog",
      "description": "Records of synchronization job outputs."
    },
    "blog_reactions/{postSlug}": {
      "schema": "BlogReaction",
      "description": "Real-time aggregated engagement reactions per blog article."
    },
    "blog_comments/{commentId}": {
      "schema": "BlogComment",
      "description": "User questions, feedback, and author replies on blog articles."
    }
  }
}
