rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 0.1 Helpers
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function isSignedIn() { return request.auth != null; }

    // 1. Validation Blueprints
    function isValidContactSubmission(data) {
      return data.keys().hasAll(['name', 'email', 'subject', 'message', 'createdAt'])
        && data.keys().size() == 5
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 200
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.subject is string
        && data.message is string && data.message.size() >= 5 && data.message.size() <= 5000
        && data.createdAt == request.time;
    }

    function isValidPartnerSubmission(data) {
      return data.keys().hasAll(['name', 'email', 'website', 'tier', 'budget', 'message', 'createdAt'])
        && data.keys().size() == 7
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.website is string && data.website.size() >= 3 && data.website.size() <= 300
        && data.tier is string && data.tier.size() <= 100
        && data.budget is string && data.budget.size() <= 200
        && data.message is string && data.message.size() <= 5000
        && data.createdAt == request.time;
    }

    function isValidUpiTransaction(data) {
      return data.keys().hasAll(['utr', 'name', 'email', 'amount', 'resourceId', 'resourceTitle', 'status', 'createdAt'])
        && data.keys().size() == 8
        && data.utr is string && data.utr.size() == 12 && data.utr.matches('^[0-9]{12}$')
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.amount is int && data.amount > 0
        && data.resourceId is string && data.resourceId.size() <= 128
        && data.resourceTitle is string && data.resourceTitle.size() <= 300
        && data.status is string && (data.status == 'pending' || data.status == 'verified' || data.status == 'failed')
        && data.createdAt == request.time;
    }

    // 2. Collection Rules
    match /contacts/{submissionId} {
      // Public can create submissions through the contact form
      allow create: if isValidContactSubmission(incoming());
      
      // No one can read, update, or delete submissions via the client
      allow read, update, delete: if false;
    }

    match /partners_submissions/{submissionId} {
      // Public can submit partner applications
      allow create: if isValidPartnerSubmission(incoming());
      
      // No one can read, update, or delete applications via the client
      allow read, update, delete: if false;
    }

    match /upi_transactions/{transactionId} {
      // Public can create UPI transaction log entries
      allow create: if isValidUpiTransaction(incoming());
      // Clients can query/read to check verification
      allow read: if true;
      allow update, delete: if false;
    }

    match /content/{contentId} {
      // Public can read syndicated content documents, and admin (authenticated or fallback) can manage it
      allow read, write: if true;
    }

    match /automation/{settingsId} {
      // Allow read and write access for automation settings
      allow read, write: if true;
    }

    match /syncLogs/{logId} {
      // Allow read and write access for synchronization logs
      allow read, write: if true;
    }
  }
}
